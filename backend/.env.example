LLM_PROVIDER=mock
MAIL_PROVIDER=mock
# To enable DeepSeek, set LLM_PROVIDER=deepseek and provide your key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# To enable a real mailbox, set MAIL_PROVIDER=imap and fill the IMAP + SMTP
# settings below. Use an app password when your provider requires one.
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_SSL=true
MAIL_IMAP_USERNAME=
MAIL_IMAP_PASSWORD=
MAIL_IMAP_FOLDER=INBOX
MAIL_IMAP_SEARCH=ALL
MAIL_IMAP_LIMIT=50
MAIL_IMAP_TIMEOUT=45
MAIL_IMAP_MARK_SEEN=false
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_SSL=true
MAIL_SMTP_STARTTLS=false
MAIL_FROM=
